# Postgres (Neon). Migration dùng bản UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth upstream. Browser calls /api/auth on this app's origin.
# Safari/local testing requires HTTPS so Secure session cookies can persist.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Lời mời nhân viên yêu cầu email đã xác minh; chỉ đặt false trong môi trường test cô lập.
INVITE_REQUIRE_VERIFIED_EMAIL=true

# Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# URL gốc của app, dùng dựng link tuyệt đối và kiểm tra Origin của Auth proxy.
# Phải khớp chính xác origin đang mở trong trình duyệt; dùng HTTPS khi test đăng nhập.
APP_BASE_URL=http://localhost:3000

# AES-256-GCM cho secret lưu trong DB và guest token. Đúng 32 byte, base64.
# Sinh khoá:  openssl rand -base64 32
# Mỗi môi trường (dev, test, Vercel Preview, Vercel Production) dùng khoá riêng; không commit khoá thật.
APP_ENCRYPTION_KEY=

# Chỉ test/CI
ZENO_TEST_DB=

# Optional catalog seed: ZENO_SEED_CATALOG=1, NEON_BRANCH=test|development, SEED_STORE_ID=<existing store UUID>
# Run with: ENV_FILE=.env.test npm run db:seed

# Neon Functions: enable only on the verified deployment branch after migration and secret setup.
PAYMENT_JOBS_ENABLED=false
# Comma-separated integration UUIDs; leave empty until cross-source identity is verified with real SePay payloads.
SEPAY_VERIFIED_DEDUPE_INTEGRATIONS=
# Reduce to 1 for high-volume backfills; allowed range 1..48 hours.
SEPAY_RECONCILE_MAX_WINDOW_HOURS=48

# Private read-only operations endpoint; distinct from encryption and SePay keys (>=32 chars).
OPS_STATUS_SECRET=
# Only set to 1 behind an independently verified ingress that overwrites XFF; direct Node defaults to socket IP.
TRUST_FORWARDED_FOR=0
# Pilot seed stays a dry run unless --execute; production additionally needs --production + ZENO_ALLOW_PROD_SEED=YES.
ZENO_SEED_PILOT=
ZENO_ALLOW_PROD_SEED=
# Rehearsal only, never a production restore/finalize.
ZENO_RESTORE_DRILL=
