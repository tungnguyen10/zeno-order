{
  "name": "zeno-order",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project nuxt",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:integration": "(test ! -f drizzle/meta/_journal.json || ENV_FILE=.env.test drizzle-kit migrate) && vitest run --project integration",
    "test:api": "(test ! -f drizzle/meta/_journal.json || ENV_FILE=.env.test drizzle-kit migrate) && vitest run --project api",
    "test:e2e": "playwright test",
    "db:seed": "tsx --tsconfig .nuxt/tsconfig.server.json scripts/seed-catalog.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@iconify-json/lucide": "1.2.149",
    "@neon/auth": "0.8.2",
    "@neon/config": "1.10.0",
    "@neon/env": "1.6.8",
    "@neondatabase/serverless": "1.2.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/ui": "4.12.0",
    "@pinia/nuxt": "1.0.2",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.14",
    "nuxt": "4.5.2",
    "pinia": "4.0.3",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.3",
    "ufo": "1.6.4",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.3.2",
    "@playwright/test": "1.63.0",
    "@testing-library/vue": "8.1.0",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/test-utils": "2.5.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.10.0",
    "h3": "1.15.11",
    "h3-next": "npm:h3@2.0.1-rc.31",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
